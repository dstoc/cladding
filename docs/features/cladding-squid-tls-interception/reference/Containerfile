FROM ubuntu:26.04@sha256:cd21a4f68a617580279d4b091cb18e3af9fa8a87500665f0ae5f7f757d17d367 AS build

ARG SQUID_VERSION=7.2
ARG SQUID_RELEASE_TAG=SQUID_7_2
ARG SQUID_SOURCE_SHA256=5e077be1d83a9e696ce8d0d9e723b1273152207a091404be68a4b9a9e18c7003

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       build-essential \
       curl \
       libexpat1-dev \
       libssl-dev \
       pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --silent --show-error --location \
       "https://github.com/squid-cache/squid/releases/download/${SQUID_RELEASE_TAG}/squid-${SQUID_VERSION}.tar.xz" \
       --output /tmp/squid.tar.xz \
    && echo "${SQUID_SOURCE_SHA256}  /tmp/squid.tar.xz" | sha256sum --check \
    && mkdir /tmp/squid-src \
    && tar -xJf /tmp/squid.tar.xz --strip-components=1 -C /tmp/squid-src

WORKDIR /tmp/squid-src
RUN ./configure \
      --prefix=/usr/local \
      --sysconfdir=/etc/squid \
      --localstatedir=/var \
      --libexecdir=/usr/local/libexec \
      --with-openssl \
      --enable-ssl-crtd \
      --enable-http-violations \
    && make -j2 \
    && make install

RUN /usr/local/sbin/squid -v > /tmp/squid-build-options.txt 2>&1 \
    && grep -q -- '--with-openssl' /tmp/squid-build-options.txt \
    && grep -q -- '--enable-ssl-crtd' /tmp/squid-build-options.txt \
    && grep -q -- '--enable-http-violations' /tmp/squid-build-options.txt \
    && test -x /usr/local/libexec/security_file_certgen

FROM ubuntu:26.04@sha256:cd21a4f68a617580279d4b091cb18e3af9fa8a87500665f0ae5f7f757d17d367

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       libexpat1 \
       libssl3t64 \
       libstdc++6 \
       openssl \
       passwd \
       util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && (getent group proxy || groupadd --system --gid 13 proxy) \
    && (getent passwd proxy || useradd --system --uid 13 --gid proxy --home-dir /nonexistent --shell /usr/sbin/nologin proxy) \
    && install -d -o proxy -g proxy -m 0750 /run/squid

COPY --from=build /usr/local /usr/local
COPY reference/startup.sh /usr/local/bin/cladding-proxy-startup
COPY reference/render-credentials.sh /usr/local/bin/cladding-proxy-render-credentials

RUN chmod 0755 /usr/local/bin/cladding-proxy-startup /usr/local/bin/cladding-proxy-render-credentials \
    && /usr/local/sbin/squid -v | grep -q 'Squid Cache: Version 7.2'

ENV PATH="/usr/local/sbin:/usr/local/bin:${PATH}"
ENTRYPOINT ["/usr/local/bin/cladding-proxy-startup"]
