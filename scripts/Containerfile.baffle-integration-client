FROM node:24.17-trixie-slim

ENV NODE_USE_SYSTEM_CA=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git jq python3 python3-requests socat \
    && rm -rf /var/lib/apt/lists/*

COPY baffle_node_integration.js /tmp/baffle_node_integration.js

CMD ["sleep", "infinity"]
